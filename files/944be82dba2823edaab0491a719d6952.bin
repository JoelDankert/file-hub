#include <SPI.h>
#include <MFRC522.h>

// ESP32 Dev Module: RC522 SDA/SS=21, SCK=18, MOSI=23, MISO=19, RST=22.
constexpr uint8_t SS_PIN = 21;
constexpr uint8_t RST_PIN = 22;
MFRC522 rfid(SS_PIN, RST_PIN);

void setup() {
  Serial.begin(115200);
  delay(1000);
  SPI.begin(18, 19, 23, SS_PIN);
  rfid.PCD_Init();
  delay(50);
  Serial.println("RC522 bereit. Karte an den Leser halten.");
  rfid.PCD_DumpVersionToSerial();
}

void loop() {
  if (!rfid.PICC_IsNewCardPresent() || !rfid.PICC_ReadCardSerial()) return;
  Serial.print("UID: ");
  for (byte i = 0; i < rfid.uid.size; ++i) {
    if (rfid.uid.uidByte[i] < 0x10) Serial.print('0');
    Serial.print(rfid.uid.uidByte[i], HEX);
    Serial.print(' ');
  }
  Serial.println();
  Serial.print("SAK: 0x");
  if (rfid.uid.sak < 0x10) Serial.print('0');
  Serial.println(rfid.uid.sak, HEX);
  Serial.print("Kartentyp: ");
  Serial.println(rfid.PICC_GetTypeName(rfid.PICC_GetType(rfid.uid.sak)));
  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
}
